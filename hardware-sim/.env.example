# URL del CSMS (CitrineOS), sin el station id al final.
# Si esta Pi esta fuera de la LAN del CSMS, usar la IP de Tailscale en vez de
# la LAN (instalar Tailscale en ambas Pis, `tailscale ip -4` en la del CSMS).
CSMS_WS_URL=ws://192.168.1.38:8081

# Debe coincidir EXACTO con el ocpp_id que cargues en el panel admin
STATION_ID=PI4-SIM-01

# Debe coincidir con una tarjeta RFID ya asignada a una unidad funcional
ID_TOKEN=RFID-PI4-SIM-01

# Corriente y tension "simuladas" cuando esta cargando (define el kW/kWh reportado)
SIM_AMPS=16
SIM_VOLTS=220

# Cada cuanto manda TransactionEvent Updated mientras carga (ms)
METER_INTERVAL_MS=10000

# Chip GPIO (verificar con `gpiodetect`; en Pi4 suele ser gpiochip0)
GPIO_CHIP=gpiochip0

# Pines GPIO (numeracion BCM)
LED_CHARGING_PIN=27
LED_AVAILABLE_PIN=22
LED_FAULT_PIN=23
BUTTON_PIN=24

# --- modbus-sim.js (simulador de medidor Acrel, proceso aparte del OCPP) ---
# Puerto no privilegiado por defecto (502 real requiere root/setcap en Linux).
# Registrar el medidor en el panel admin (o INSERT en medidores_modbus) con
# host=<ip de esta Pi>, puerto=MODBUS_SIM_PORT, modelo=MODBUS_SIM_MODEL.
MODBUS_SIM_HOST=0.0.0.0
MODBUS_SIM_PORT=5020
MODBUS_SIM_UNIT_ID=1
MODBUS_SIM_MODEL=ADL400
MODBUS_SIM_AMPS_MIN=8
MODBUS_SIM_AMPS_MAX=45
MODBUS_SIM_AMPS_STEP=1.5
MODBUS_SIM_WALK_INTERVAL_MS=2000
MODBUS_SIM_DEBUG=false
