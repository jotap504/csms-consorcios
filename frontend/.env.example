# Only needed for `npm run dev` (no nginx proxy in dev mode). In production
# the Docker build defaults to the relative "/api", proxied by nginx.
VITE_API_URL=http://192.168.1.38:3001

# Google OAuth 2.0 Client ID (public, safe to expose in the frontend bundle).
# Leave empty to hide the "Ingresar con Google" button.
VITE_GOOGLE_CLIENT_ID=
